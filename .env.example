# Telegram token from BotFather. Keep real credentials in .env, never in Git.
TELEGRAM_BOT_TOKEN=

# Explicit project timezone, used for all booking dates and times.
E_BLOCK_TIMEZONE=Asia/Singapore

# Use sqlite locally; use PostgreSQL in production.
DATABASE_URL=sqlite+aiosqlite:///./e_block_bot.db

# Required by the included PostgreSQL Docker Compose deployment.
POSTGRES_PASSWORD=

# Telegram user IDs allowed to use admin commands, comma-separated.
ADMIN_USER_IDS=

# Lounge operates 24 hours. Starts and durations use 30-minute increments.
SLOT_INCREMENT_MINUTES=30
MAX_DAILY_BOOKING_MINUTES=180
